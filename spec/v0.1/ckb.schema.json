{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/riddhimohansharma/ckb-spec/schema/v0.1/ckb.schema.json",
  "title": "Codebase Knowledge Base (CKB) artifact",
  "description": "DRAFT v0.1 — unstable. Breaking changes may occur without notice until 1.0. One artifact describes one repository at one commit. Canonical location: <repo-root>/.ckb/ckb.json.",
  "type": "object",
  "required": ["ckb_version", "repo", "confidence_summary", "entities"],
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "properties": {
    "ckb_version": { "const": "0.1" },
    "repo": { "$ref": "#/$defs/repo" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "confidence_summary": { "$ref": "#/$defs/confidence_summary" },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "datastores": { "type": "array", "items": { "$ref": "#/$defs/datastore" } },
        "business_rules": { "type": "array", "items": { "$ref": "#/$defs/business_rule" } },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } }
      }
    },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }
  },
  "$defs": {
    "repo": {
      "description": "Repository identity. (url, commit_sha) is the node key; generated_at is the freshness signal.",
      "type": "object",
      "required": ["url", "branch", "commit_sha", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1, "description": "Canonical clone URL, or file:// URL for local-only repos." },
        "branch": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$", "description": "The analysed SOURCE commit (full SHA-1 or SHA-256, lowercase). Committing the KB itself does not change it; see the freshness rule." },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "confidence": { "enum": ["confirmed", "inferred", "unknown"] },
    "confidence_summary": {
      "type": "object",
      "required": ["confirmed", "inferred", "unknown", "overall"],
      "additionalProperties": false,
      "properties": {
        "confirmed": { "type": "integer", "minimum": 0 },
        "inferred": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "overall": { "$ref": "#/$defs/confidence" }
      }
    },
    "repo_path": {
      "description": "Repo-relative POSIX path. No leading slash, no '..' segments. Must not point into the .ckb/ directory (rule R7).",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/]",
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "provenance": {
      "type": "object",
      "required": ["path", "line"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/repo_path" },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "claim": {
      "description": "Fields shared by every entity and relation. Provenance is mandatory unless confidence is 'unknown'.",
      "type": "object",
      "required": ["confidence", "provenance"],
      "properties": {
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
      },
      "if": { "properties": { "confidence": { "enum": ["confirmed", "inferred"] } } },
      "then": { "properties": { "provenance": { "minItems": 1 } } }
    },
    "entity_base": {
      "allOf": [{ "$ref": "#/$defs/claim" }],
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "entity_id": {
      "type": "string",
      "pattern": "^(component|interface|dependency|datastore|business_rule|workflow):.+$"
    },
    "package_key": {
      "description": "Normalized package join key.",
      "type": "string",
      "pattern": "^(npm:(@[a-z0-9._~-]+/)?[a-z0-9._~-]+|pypi:[a-z0-9]+([._-][a-z0-9]+)*|maven:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+|go:[^\\s]+|cargo:[a-z0-9_-]+|nuget:[A-Za-z0-9._-]+|gem:[A-Za-z0-9._-]+|other:[^\\s]+)$"
    },
    "component": {
      "allOf": [{ "$ref": "#/$defs/entity_base" }],
      "unevaluatedProperties": false,
      "required": ["module_id", "kind"],
      "properties": {
        "id": { "pattern": "^component:" },
        "module_id": { "$ref": "#/$defs/repo_path", "description": "Stable repo-relative identifier (directory or file path)." },
        "kind": { "enum": ["service", "library", "module", "cli", "ui", "job", "other"] },
        "language": { "type": "string" }
      }
    },
    "interface": {
      "unevaluatedProperties": false,
      "required": ["kind", "role"],
      "properties": {
        "id": { "pattern": "^interface:" },
        "kind": { "enum": ["http", "event", "rpc", "cli", "library"] },
        "role": { "enum": ["provides", "consumes"] },
        "http": {
          "type": "object",
          "required": ["method", "normalized_path"],
          "additionalProperties": false,
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "ANY"] },
            "normalized_path": {
              "type": "string",
              "pattern": "^/([A-Za-z0-9._~-]+|\\{[a-z_][a-z0-9_]*\\})?(/([A-Za-z0-9._~-]+|\\{[a-z_][a-z0-9_]*\\}))*$",
              "description": "Path params as {snake_case}; no trailing slash (except '/'); no query string."
            },
            "host": { "type": "string", "description": "For role=consumes: logical target service, if known." }
          }
        },
        "event": {
          "type": "object",
          "required": ["transport", "topic"],
          "additionalProperties": false,
          "properties": {
            "transport": { "enum": ["kafka", "sqs", "sns", "rabbitmq", "pubsub", "eventbridge", "nats", "redis", "webhook", "other"] },
            "topic": { "type": "string", "minLength": 1 }
          }
        },
        "rpc": {
          "type": "object",
          "required": ["protocol", "service", "method"],
          "additionalProperties": false,
          "properties": {
            "protocol": { "enum": ["grpc", "thrift", "jsonrpc", "graphql", "other"] },
            "service": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 }
          }
        },
        "symbol": { "type": "string", "description": "For kind=cli|library: command or exported symbol." }
      },
      "allOf": [
        { "$ref": "#/$defs/entity_base" },
        { "if": { "properties": { "kind": { "const": "http" } } }, "then": { "required": ["http"] } },
        { "if": { "properties": { "kind": { "const": "event" } } }, "then": { "required": ["event"] } },
        { "if": { "properties": { "kind": { "const": "rpc" } } }, "then": { "required": ["rpc"] } },
        { "if": { "properties": { "kind": { "enum": ["cli", "library"] } } }, "then": { "required": ["symbol"] } }
      ]
    },
    "dependency": {
      "allOf": [{ "$ref": "#/$defs/entity_base" }],
      "unevaluatedProperties": false,
      "required": ["package_key", "scope"],
      "properties": {
        "id": { "pattern": "^dependency:" },
        "package_key": { "$ref": "#/$defs/package_key" },
        "version_constraint": { "type": "string" },
        "scope": { "enum": ["runtime", "dev", "build", "test", "peer", "optional"] }
      }
    },
    "datastore": {
      "allOf": [{ "$ref": "#/$defs/entity_base" }],
      "unevaluatedProperties": false,
      "required": ["engine", "access"],
      "properties": {
        "id": { "pattern": "^datastore:" },
        "engine": { "enum": ["postgres", "mysql", "sqlite", "mssql", "oracle", "mongodb", "dynamodb", "redis", "elasticsearch", "s3", "gcs", "filesystem", "other"] },
        "schema": { "type": "string" },
        "table": { "type": "string", "description": "Table, collection, bucket, or key prefix." },
        "access": { "enum": ["read", "write", "readwrite"] }
      }
    },
    "business_rule": {
      "allOf": [{ "$ref": "#/$defs/entity_base" }],
      "unevaluatedProperties": false,
      "required": ["statement"],
      "properties": {
        "id": { "pattern": "^business_rule:" },
        "statement": { "type": "string", "minLength": 1 },
        "applies_to": { "type": "array", "items": { "$ref": "#/$defs/entity_id" } }
      }
    },
    "workflow": {
      "allOf": [{ "$ref": "#/$defs/entity_base" }],
      "unevaluatedProperties": false,
      "required": ["steps"],
      "properties": {
        "id": { "pattern": "^workflow:" },
        "trigger": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["order", "description"],
            "additionalProperties": false,
            "properties": {
              "order": { "type": "integer", "minimum": 1 },
              "description": { "type": "string", "minLength": 1 },
              "entity_id": { "$ref": "#/$defs/entity_id" }
            }
          }
        }
      }
    },
    "relation": {
      "allOf": [{ "$ref": "#/$defs/claim" }],
      "unevaluatedProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/entity_id" },
        "to": { "$ref": "#/$defs/entity_id" },
        "kind": { "enum": ["contains", "calls", "provides", "consumes", "depends_on", "reads", "writes", "publishes", "subscribes", "enforces"] }
      }
    }
  }
}
